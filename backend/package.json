{
  "name": "xbox-betting-backend",
  "version": "1.0.0",
  "description": "Backend for Xbox Sports Betting",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "prisma generate && node src/migrate.js && prisma db push --accept-data-loss && node src/index.js",
    "dev": "nodemon src/index.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0"
  }
}
