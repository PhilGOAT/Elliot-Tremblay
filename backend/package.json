{
  "name": "xbox-betting-backend",
  "version": "1.0.0",
  "description": "Backend for Xbox Sports Betting",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "prisma generate && node src/migrate.js && prisma db push --accept-data-loss && node src/index.js",
    "dev": "nodemon src/index.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^7.2.0",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "fluent-ffmpeg": "^2.1.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-fetch": "^2.7.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^7.2.0"
  }
}
