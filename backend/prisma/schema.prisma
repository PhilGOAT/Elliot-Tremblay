generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  balance   Int      @default(1000) // Monnaie virtuelle de départ
  wins      Int      @default(0)
  losses    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bets           Bet[]
  matchesAsPlayer1 Match[] @relation("Player1")
  matchesAsPlayer2 Match[] @relation("Player2")
}

model Match {
  id           String      @id @default(uuid())
  game         GameType
  player1Name  String      // Nom libre (ex: "Patriots", "Mon équipe")
  player2Name  String      // Nom libre (ex: "Chiefs", "Adversaire")
  player1Id    String?     // Optionnel - lié à un user
  player2Id    String?     // Optionnel - lié à un user
  player1      User?       @relation("Player1", fields: [player1Id], references: [id])
  player2      User?       @relation("Player2", fields: [player2Id], references: [id])
  player1Score Int?
  player2Score Int?
  winnerId     String?
  status       MatchStatus @default(PENDING)
  createdBy    String      // User qui a créé le match
  scheduledAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  bets Bet[]
}

model Bet {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  matchId   String
  match     Match     @relation(fields: [matchId], references: [id])
  amount    Int
  prediction String   // "player1" ou "player2"
  status    BetStatus @default(PENDING)
  payout    Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, matchId]) // Un seul pari par match par utilisateur
}

enum GameType {
  MADDEN
  NHL
  FIFA
  NBA2K
  MLB
  UFC
  OTHER
}

enum MatchStatus {
  PENDING
  LIVE
  COMPLETED
  CANCELLED
}

enum BetStatus {
  PENDING
  WON
  LOST
  REFUNDED
}
