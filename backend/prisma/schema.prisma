generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  username       String
  email          String
  password       String
  isAdmin        Boolean   @default(false) // Admin du site
  balance        Int       @default(1000) // Monnaie virtuelle de départ
  wins           Int       @default(0)
  losses         Int       @default(0)
  lastDailyBonus DateTime? // Dernière réclamation du bonus quotidien

  // Gamertags des différentes plateformes
  xboxGamertag   String?   // Xbox Live
  psnId          String?   // PlayStation Network
  eaId           String?   // EA App (pour Madden, NHL, FIFA)
  nintendoId     String?   // Nintendo Switch Online
  steamName      String?   // Steam (PC)
  twitchUsername String?   // Nom d'utilisateur Twitch

  // Consentement streaming
  streamingConsent Boolean @default(false) // Autorise les autres à voir ses streams
  streamVisibility String  @default("private") // "private" = admin seulement, "public" = tout le monde

  // Statut de vérification des plateformes
  xboxVerified   Boolean   @default(false)
  psnVerified    Boolean   @default(false)
  eaVerified     Boolean   @default(false)
  nintendoVerified Boolean @default(false)
  steamVerified  Boolean   @default(false)

  // Xbox Live API Data
  xboxXuid         String?   // Xbox User ID unique
  xboxAccessToken  String?   // Token d'accès Microsoft
  xboxRefreshToken String?   // Token de rafraîchissement
  xboxTokenExpiry  DateTime? // Expiration du token
  xboxGamerscore   Int?      // Score Xbox du joueur
  xboxAvatar       String?   // URL de l'avatar Xbox

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  bets           Bet[]
  matchesAsPlayer1 Match[] @relation("Player1")
  matchesAsPlayer2 Match[] @relation("Player2")
  notifications  Notification[]

  // Relations amis
  sentFriendRequests     Friendship[] @relation("FriendshipSender")
  receivedFriendRequests Friendship[] @relation("FriendshipReceiver")
}

model Friendship {
  id         String           @id @default(uuid())
  senderId   String
  sender     User             @relation("FriendshipSender", fields: [senderId], references: [id])
  receiverId String
  receiver   User             @relation("FriendshipReceiver", fields: [receiverId], references: [id])
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

enum FriendshipStatus {
  PENDING   // Demande envoyée
  ACCEPTED  // Amis
  DECLINED  // Refusée
  BLOCKED   // Bloqué
}

model Match {
  id           String      @id @default(uuid())
  game         GameType
  player1Name  String      // Nom libre (ex: "Patriots", "Mon équipe")
  player2Name  String      // Nom libre (ex: "Chiefs", "Adversaire")
  player1Type  PlayerType  @default(HUMAN) // Humain ou CPU
  player2Type  PlayerType  @default(HUMAN) // Humain ou CPU
  player1Difficulty CpuDifficulty? // Difficulté si CPU
  player2Difficulty CpuDifficulty? // Difficulté si CPU
  player1HumanName  String?        // Nom du joueur humain
  player2HumanName  String?        // Nom du joueur humain
  player1Id    String?     // Optionnel - lié à un user
  player2Id    String?     // Optionnel - lié à un user
  player1      User?       @relation("Player1", fields: [player1Id], references: [id])
  player2      User?       @relation("Player2", fields: [player2Id], references: [id])
  player1Score Int?
  player2Score Int?
  winnerId     String?
  status       MatchStatus @default(PENDING)

  // Double confirmation des scores
  player1SubmittedP1Score Int?    // Score P1 soumis par joueur 1
  player1SubmittedP2Score Int?    // Score P2 soumis par joueur 1
  player1SubmittedAt      DateTime?
  player2SubmittedP1Score Int?    // Score P1 soumis par joueur 2
  player2SubmittedP2Score Int?    // Score P2 soumis par joueur 2
  player2SubmittedAt      DateTime?
  scoreDispute            Boolean  @default(false) // Conflit de scores
  createdBy    String      // User qui a créé le match
  scheduledAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  bets Bet[]
}

model Bet {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  matchId   String
  match     Match     @relation(fields: [matchId], references: [id])
  amount    Int
  betType   BetType   @default(WINNER)  // Type de pari
  prediction String   // "player1", "player2", "yes", "no"
  status    BetStatus @default(PENDING)
  payout    Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, matchId, betType]) // Un seul pari par type par match par utilisateur
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  matchId   String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model Tournament {
  id           String           @id @default(uuid())
  name         String
  game         GameType
  size         Int              // 4, 8, or 16 teams
  status       TournamentStatus @default(REGISTRATION)
  createdBy    String
  participants TournamentParticipant[]
  rounds       TournamentRound[]
  winnerId     String?
  prizePool    Int              @default(0)
  entryFee     Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model TournamentParticipant {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  teamName     String
  playerName   String?    // Nom du joueur humain
  playerType   PlayerType @default(HUMAN)
  seed         Int?
  eliminated   Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@unique([tournamentId, teamName])
}

model TournamentRound {
  id           String            @id @default(uuid())
  tournamentId String
  tournament   Tournament        @relation(fields: [tournamentId], references: [id])
  roundNumber  Int               // 1=Finals, 2=Semis, 3=Quarters, etc.
  matches      TournamentMatch[]
  createdAt    DateTime          @default(now())

  @@unique([tournamentId, roundNumber])
}

model TournamentMatch {
  id              String          @id @default(uuid())
  roundId         String
  round           TournamentRound @relation(fields: [roundId], references: [id])
  matchNumber     Int
  team1Name       String?
  team2Name       String?
  team1Score      Int?
  team2Score      Int?
  winnerId        String?         // teamName of winner
  status          MatchStatus     @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum GameType {
  MADDEN
  NHL
  FIFA
  NBA2K
  MLB
  UFC
  OTHER
}

enum MatchStatus {
  PENDING
  LIVE
  COMPLETED
  CANCELLED
}

enum BetStatus {
  PENDING
  WON
  LOST
  REFUNDED
}

enum BetType {
  WINNER      // Pari sur le gagnant
  CLOSE_MATCH // Pari sur match serré (écart <= 7 points)
  HIGH_SCORE  // Pari sur haut score (total >= 50 points)
}

enum PlayerType {
  HUMAN
  CPU
}

enum CpuDifficulty {
  ROOKIE
  PRO
  ALL_PRO
  ALL_MADDEN
}

enum NotificationType {
  BET_WON
  BET_LOST
  BET_REFUNDED
  NEW_MATCH
  MATCH_RESULT
  FRIEND_REQUEST
  FRIEND_ACCEPTED
}

enum TournamentStatus {
  REGISTRATION
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ==========================================
// LIVE STREAMING & REAL-TIME BETTING MODELS
// ==========================================

model LiveStream {
  id           String       @id @default(uuid())
  title        String       // "Alex vs Lordie - NHL 24"
  game         GameType
  streamUrl    String       // URL Twitch/YouTube
  streamerId   String       // User qui stream
  player1Name  String       // Nom équipe/joueur 1
  player2Name  String       // Nom équipe/joueur 2
  status       StreamStatus @default(WAITING)

  // État du match en temps réel
  currentScore1    Int      @default(0)
  currentScore2    Int      @default(0)
  currentPeriod    Int      @default(1)
  currentTime      String   @default("20:00") // Temps restant dans la période

  // Statistiques entre-périodes
  shots1           Int      @default(0)
  shots2           Int      @default(0)
  hits1            Int      @default(0)
  hits2            Int      @default(0)
  faceoffsWon1     Int      @default(0)
  faceoffsWon2     Int      @default(0)
  penaltyMinutes1  Int      @default(0)
  penaltyMinutes2  Int      @default(0)
  timeOnAttack1    String?  // "05:32"
  timeOnAttack2    String?

  // Métadonnées
  viewerCount      Int      @default(0)
  startedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  events       LiveEvent[]
  liveBets     LiveBet[]
}

model LiveEvent {
  id           String        @id @default(uuid())
  streamId     String
  stream       LiveStream    @relation(fields: [streamId], references: [id])
  eventType    LiveEventType
  period       Int
  gameTime     String        // "14:32"
  description  String        // "But de Ovechkin (assist: Crosby)"
  player1Score Int?          // Score après l'événement
  player2Score Int?
  detectedAt   DateTime      @default(now())
}

model LiveBet {
  id           String        @id @default(uuid())
  userId       String
  streamId     String
  stream       LiveStream    @relation(fields: [streamId], references: [id])
  betType      LiveBetType
  prediction   String        // "player1", "player2", "over", "under", valeur numérique, etc.
  odds         Float         // Cote au moment du pari
  amount       Int
  status       BetStatus     @default(PENDING)
  payout       Int?
  placedAt     DateTime      @default(now())
  settledAt    DateTime?

  // Détails spécifiques selon le type de pari
  spreadValue  Float?        // Pour spread bets (+1.5, -1.5)
  totalValue   Float?        // Pour over/under (5.5 buts)
  periodNumber Int?          // Pour paris sur une période spécifique
}

enum StreamStatus {
  WAITING      // En attente de début
  LIVE         // En cours
  INTERMISSION // Entre-périodes
  ENDED        // Terminé
  CANCELLED    // Annulé
}

enum LiveEventType {
  GOAL             // But marqué
  PENALTY          // Pénalité
  PERIOD_START     // Début de période
  PERIOD_END       // Fin de période
  POWERPLAY_START  // Avantage numérique début
  POWERPLAY_END    // Avantage numérique fin
  GAME_START       // Début du match
  GAME_END         // Fin du match
  OVERTIME_START   // Début prolongation
  SHOOTOUT_START   // Début tirs de barrage
}

enum LiveBetType {
  MATCH_WINNER      // Gagnant du match
  SPREAD            // Spread (+1.5, -1.5)
  TOTAL_GOALS       // Over/Under buts total
  PERIOD_WINNER     // Gagnant d'une période
  NEXT_GOAL         // Prochain but
  FIRST_GOAL        // Premier but du match
  EXACT_SCORE       // Score exact final
  TEAM_TOTAL        // Total buts d'une équipe
}

// ==========================================
// OCR LEARNING / RAG SYSTEM
// ==========================================

model OcrCorrection {
  id              String   @id @default(uuid())
  streamId        String?  // Optionnel - lié à un stream
  game            GameType // Le jeu (NHL, FIFA, etc.)

  // Ce que l'OCR a détecté
  rawText         String   // Texte brut détecté par OCR
  detectedScore1  Int?     // Score 1 détecté
  detectedScore2  Int?     // Score 2 détecté
  detectedPeriod  Int?     // Période détectée
  detectedTime    String?  // Temps détecté

  // Ce que l'utilisateur a corrigé
  correctedScore1 Int?     // Score 1 corrigé par l'utilisateur
  correctedScore2 Int?     // Score 2 corrigé par l'utilisateur
  correctedPeriod Int?     // Période corrigée
  correctedTime   String?  // Temps corrigé

  // Feedback
  wasCorrect      Boolean  @default(false) // L'OCR avait-il raison?
  wasIncorrect    Boolean  @default(false) // Marqué comme erroné par l'utilisateur
  feedbackNote    String?  // Note optionnelle de l'utilisateur

  // Métadonnées pour le matching
  imageHash       String?  // Hash de l'image pour trouver des images similaires
  twitchChannel   String?  // Channel Twitch source
  screenRegion    String?  // Région de l'écran analysée (scoreboard, fullscreen, etc.)

  // Stats
  confidence      Float?   // Confiance de l'OCR (0-1)
  processingTime  Int?     // Temps de traitement en ms

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([game])
  @@index([rawText])
  @@index([imageHash])
}

model OcrPattern {
  id              String   @id @default(uuid())
  game            GameType

  // Pattern appris
  patternType     String   // "score", "time", "period"
  rawPattern      String   // Le pattern brut (ex: "3 - 2", "14:32")
  normalizedValue String   // La valeur normalisée

  // Stats d'apprentissage
  successCount    Int      @default(0) // Nombre de fois correct
  failureCount    Int      @default(0) // Nombre de fois incorrect
  confidence      Float    @default(0.5) // Confiance calculée

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([game, patternType, rawPattern])
  @@index([game, patternType])
}

// ==========================================
// ACTIVE STREAM MONITORING (Auto OCR)
// ==========================================

model ActiveStream {
  id              String   @id @default(uuid())
  userId          String   // Utilisateur qui stream
  twitchChannel   String   // Nom du channel Twitch

  // Score détecté en temps réel par OCR
  detectedScore1  Int?
  detectedScore2  Int?
  detectedPeriod  Int?
  detectedTime    String?
  powerPlay       Boolean  @default(false)
  screenType      String?  // GAMEPLAY, GOAL, INTERMISSION, STATS

  // Confiance et status
  confidence      Float?   // Confiance de la dernière détection
  isLive          Boolean  @default(true)
  lastOcrAt       DateTime? // Dernière analyse OCR
  ocrError        String?  // Dernière erreur OCR

  // Historique des scores (pour détecter les buts)
  previousScore1  Int?
  previousScore2  Int?

  // Métadonnées
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  updatedAt       DateTime @updatedAt

  @@unique([userId])
  @@unique([twitchChannel])
  @@index([isLive])
}
